<mvc:View
  controllerName="{{namespace}}.ext.controller.Main"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:macros="sap.fe.macros">
  <Page id="customPage" title="{i18n>appTitle}">
    <content>
      <VBox class="sapUiSmallMargin">
        <macros:FilterBar id="filterBar" metaPath="@com.sap.vocabularies.UI.v1.SelectionFields" />
        <macros:Table id="table" metaPath="@com.sap.vocabularies.UI.v1.LineItem" />
        {{directRegionMarkup}}
      </VBox>
    </content>
  </Page>
</mvc:View>
