specVersion: "3.0"
metadata:
  name: {{projectName}}
type: application
framework:
  name: SAPUI5
  version: "1.120.0"
  libraries:
    - name: sap.f
    - name: sap.m
    - name: sap.ui.core
    - name: themelib_sap_horizon
server:
  customMiddleware:
    - name: fiori-tools-proxy
      afterMiddleware: compression
      configuration:
        ignoreCertErrors: false
        backend:
          - path: {{backendPath}}
            url: {{origin}}
