<mvc:View
  controllerName="{{namespace}}.controller.View"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">
  <Page id="mainPage" title="{i18n>appTitle}">
    <content>
      <Table id="dataTable" items="{/{{entitySet}}}" growing="true" growingScrollToLoad="true" sticky="ColumnHeaders">
        <columns>
{{columnsMarkup}}
        </columns>
        <items>
          <ColumnListItem>
{{cellsMarkup}}
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
