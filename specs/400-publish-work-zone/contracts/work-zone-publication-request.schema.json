{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/btp-agent/work-zone-publication-request.schema.json",
  "title": "Protocol 400 Work Zone Publication Request",
  "type": "object",
  "required": ["requestVersion", "requestId", "handoff", "deployment", "application", "target", "publishIntent", "requestedAt"],
  "properties": {
    "requestVersion": { "const": "1.0" },
    "requestId": { "type": "string", "format": "uuid" },
    "handoff": {
      "type": "object",
      "required": ["handoffVersion", "handoffId", "planId", "stepId", "protocol", "completedDependencies"],
      "properties": {
        "handoffVersion": { "const": "1.0" },
        "handoffId": { "type": "string", "format": "uuid" },
        "planId": { "type": "string", "format": "uuid" },
        "stepId": { "type": "string", "minLength": 1 },
        "protocol": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "400" },
            "version": { "const": "1.0" }
          },
          "additionalProperties": false
        },
        "completedDependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["resultId", "protocol", "status", "operationId", "applicationId", "sapCloudService", "artifactDigest", "subaccount", "verifiedAt"],
      "properties": {
        "resultId": { "type": "string", "format": "uuid" },
        "protocol": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "300" },
            "version": { "const": "1.0" }
          },
          "additionalProperties": false
        },
        "status": { "const": "SUCCEEDED" },
        "operationId": { "type": "string", "minLength": 1 },
        "applicationId": { "type": "string", "minLength": 1 },
        "sapCloudService": { "type": "string", "minLength": 1 },
        "artifactDigest": { "$ref": "#/$defs/sha256Hex" },
        "subaccount": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": ["sapAppId", "sapCloudService", "manifestDigest", "inboundKey", "semanticObject", "action", "canonicalIntent"],
      "properties": {
        "sapAppId": { "type": "string", "minLength": 1 },
        "sapCloudService": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "inboundKey": { "type": "string", "minLength": 1 },
        "semanticObject": { "$ref": "#/$defs/intentSegment" },
        "action": { "$ref": "#/$defs/intentSegment" },
        "canonicalIntent": { "type": "string", "pattern": "^#[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9][A-Za-z0-9._-]*$" }
      },
      "additionalProperties": false
    },
    "target": { "$ref": "#/$defs/target" },
    "publishIntent": {
      "type": "object",
      "required": ["mode", "operations", "targetFingerprint"],
      "properties": {
        "mode": { "enum": ["PREVIEW", "PUBLISH"] },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationType" }
        },
        "targetFingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "PREVIEW" } }, "required": ["mode"] },
          "then": { "properties": { "operations": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "mode": { "const": "PUBLISH" } }, "required": ["mode"] },
          "then": { "properties": { "operations": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approvalId", "approved", "targetFingerprint", "operationFingerprint", "approvedAt", "expiresAt"],
      "properties": {
        "approvalId": { "type": "string", "minLength": 1 },
        "approved": { "const": true },
        "targetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "operationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "publishIntent": { "properties": { "mode": { "const": "PUBLISH" } }, "required": ["mode"] } },
        "required": ["publishIntent"]
      },
      "then": { "required": ["approval"] },
      "else": { "not": { "required": ["approval"] } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "sha256Hex": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "intentSegment": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "operationType": {
      "enum": ["REFRESH_CONTENT_PROVIDER", "IMPORT_CONTENT", "ASSIGN_CONTENT_TO_SITE", "UPDATE_SITE", "CREATE_TILE", "UPDATE_TILE", "ASSIGN_ROLE"]
    },
    "target": {
      "type": "object",
      "required": ["edition", "subaccount", "site", "contentTarget"],
      "properties": {
        "edition": { "enum": ["STANDARD", "ADVANCED"] },
        "subaccount": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "minLength": 1 },
        "contentTarget": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
