{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/btp-agent/work-zone-publication-result.schema.json",
  "title": "Protocol 400 Work Zone Publication Result",
  "type": "object",
  "required": ["resultVersion", "resultId", "requestId", "protocol", "status", "target", "preflight", "operations", "validation", "retryable", "recoveryGuidance", "completedAt"],
  "properties": {
    "resultVersion": { "const": "1.0" },
    "resultId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "format": "uuid" },
    "protocol": {
      "type": "object",
      "required": ["id", "version", "registryStatus"],
      "properties": {
        "id": { "const": "400" },
        "version": { "const": "1.0" },
        "registryStatus": { "enum": ["DEFINED", "IMPLEMENTED"] }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["BLOCKED", "READY_FOR_APPROVAL", "SUCCEEDED", "VALIDATION_FAILED", "FAILED"] },
    "target": { "$ref": "#/$defs/target" },
    "preflight": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "code"],
        "properties": {
          "name": { "enum": ["HANDOFF", "DEPLOYMENT", "TARGET", "SUBACCOUNT", "MANIFEST", "NAVIGATION", "APPROVAL", "PROTOCOL_STATUS"] },
          "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
          "code": { "type": "string", "minLength": 1 },
          "evidence": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "type", "desiredStateFingerprint", "status", "resource", "startedAt", "completedAt", "code"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "type": { "$ref": "#/$defs/operationType" },
          "desiredStateFingerprint": { "$ref": "#/$defs/fingerprint" },
          "status": { "enum": ["SUCCEEDED", "NO_CHANGE", "FAILED", "NOT_RUN"] },
          "resource": {
            "type": ["object", "null"],
            "properties": {
              "type": { "enum": ["CONTENT_PROVIDER", "CONTENT", "SITE", "TILE", "ROLE"] },
              "id": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "id"],
            "additionalProperties": false
          },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "code": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["contentDiscovery", "siteAssignment", "navigation", "visibility"],
      "properties": {
        "contentDiscovery": { "$ref": "#/$defs/validationCheck" },
        "siteAssignment": { "$ref": "#/$defs/validationCheck" },
        "navigation": { "$ref": "#/$defs/validationCheck" },
        "visibility": { "$ref": "#/$defs/validationCheck" }
      },
      "additionalProperties": false
    },
    "retryable": { "type": "boolean" },
    "recoveryGuidance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "operationType": {
      "enum": ["REFRESH_CONTENT_PROVIDER", "IMPORT_CONTENT", "ASSIGN_CONTENT_TO_SITE", "UPDATE_SITE", "CREATE_TILE", "UPDATE_TILE", "ASSIGN_ROLE"]
    },
    "target": {
      "type": "object",
      "required": ["edition", "subaccount", "site", "contentTarget"],
      "properties": {
        "edition": { "enum": ["STANDARD", "ADVANCED"] },
        "subaccount": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "minLength": 1 },
        "contentTarget": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "validationCheck": {
      "type": "object",
      "required": ["status", "code", "evidence"],
      "properties": {
        "status": { "enum": ["PASSED", "FAILED", "NOT_VERIFIED", "NOT_RUN"] },
        "code": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
