{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/200/composition-request.schema.json",
  "title": "Protocol 200 CompositionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoffVersion", "handoffId", "planId", "stepId", "protocol", "completedDependencies", "requestedAt", "solutionId", "outputDirectory", "components", "identity", "requirements"],
  "properties": {
    "handoffVersion": { "const": "1.0" },
    "handoffId": { "type": "string", "format": "uuid" },
    "planId": { "type": "string", "format": "uuid" },
    "stepId": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "const": "200" }, "version": { "const": "1.0" } }
    },
    "completedDependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "solutionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resultId", "protocol", "kind", "validationStatus", "outputPath", "checksum", "capabilities", "validatedAt"],
        "properties": {
          "resultId": { "type": "string", "format": "uuid" },
          "protocol": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } },
          "kind": { "enum": ["BACKEND", "FRONTEND"] },
          "validationStatus": { "const": "PASSED" },
          "outputPath": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "capabilities": { "type": "object" },
          "validatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "version"],
      "properties": {
        "applicationId": { "type": "string", "minLength": 1 },
        "sapCloudService": { "type": ["string", "null"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "offering", "plan"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "offering": { "type": "string", "minLength": 1 },
          "plan": { "type": "string", "minLength": 1 },
          "configuration": { "type": "object" }
        }
      }
    }
  }
}
