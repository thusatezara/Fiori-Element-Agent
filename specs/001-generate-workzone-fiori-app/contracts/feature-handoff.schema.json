{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-handoff.schema.json",
  "title": "FeatureHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "handoffId", "sourceRunId", "requirementIds", "kind", "status", "problem", "acceptanceCriteria", "dependencies", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "handoffId": { "type": "string", "format": "uuid" },
    "sourceRunId": { "type": "string", "format": "uuid" },
    "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "kind": { "enum": ["AUTH_SUPPORT", "EXTENSION", "CUSTOM_PAGE", "BACKEND_CHANGE", "FREESTYLE_ARCHITECTURE"] },
    "status": { "enum": ["PROPOSED", "ACCEPTED", "IN_PROGRESS", "VERIFIED", "REJECTED", "BLOCKED"] },
    "problem": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
