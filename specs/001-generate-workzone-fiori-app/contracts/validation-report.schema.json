{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "complete", "checks", "requirements", "generatedFiles", "handoffs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "format": "uuid" },
    "complete": { "type": "boolean" },
    "outputPath": { "type": "string" },
    "mtarPath": { "type": "string" },
    "mtarDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "scope", "mandatory", "status", "evidence"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "mandatory": { "type": "boolean" },
          "status": { "enum": ["PASSED", "FAILED", "SKIPPED"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "durationMs": { "type": "integer", "minimum": 0 },
          "command": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "mandatory", "status"],
        "properties": {
          "requirementId": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "status": { "enum": ["READY", "BLOCKED_BY_AUTH", "BLOCKED_BY_BACKEND", "ROUTED_TO_EXTENSION", "ROUTED_TO_CUSTOM_PAGE", "REQUIRES_ARCHITECTURE_DECISION", "VERIFIED", "FAILED", "DEFERRED"] }
        }
      }
    },
    "generatedFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "handoffs": { "type": "array", "items": { "$ref": "feature-handoff.schema.json" } }
  }
}
