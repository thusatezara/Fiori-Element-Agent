{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cli-envelope.schema.json",
  "title": "CLIEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "runId", "state", "data", "errors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "command": { "enum": ["assess", "approve", "generate", "verify", "resume"] },
    "ok": { "type": "boolean" },
    "runId": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    },
    "state": {
      "oneOf": [
        { "enum": ["NEW", "ASSESSED", "AWAITING_APPROVAL", "APPROVED", "GENERATING", "VERIFYING", "FINALIZED", "FAILED", "BLOCKED"] },
        { "type": "null" }
      ]
    },
    "data": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "details": { "type": "object" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "properties": { "errors": { "maxItems": 0 } }
      },
      "else": {
        "properties": { "errors": { "minItems": 1 } }
      }
    }
  ]
}
