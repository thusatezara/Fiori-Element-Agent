{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-request.schema.json",
  "title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "outputPath", "app", "service", "launchpad", "deployment", "requirements"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "format": "uuid" },
    "outputPath": { "type": "string", "minLength": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "namespace", "floorplan", "odataVersion", "minimumUI5Version", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "floorplan": { "const": "LIST_REPORT_OBJECT_PAGE" },
        "odataVersion": { "const": "V4" },
        "minimumUI5Version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "mainEntity"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "mainEntity": { "type": "string", "minLength": 1 }
      }
    },
    "launchpad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticObject", "action", "tileTitle"],
      "properties": {
        "semanticObject": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "tileTitle": { "type": "string", "minLength": 1 },
        "tileSubtitle": { "type": "string", "minLength": 1 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sapCloudService", "backendDestination", "approuter"],
      "properties": {
        "sapCloudService": { "type": "string", "minLength": 1 },
        "backendDestination": { "type": "string", "minLength": 1 },
        "approuter": { "const": "MANAGED" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "mandatory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "mandatory": { "type": "boolean" },
          "signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
