{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-report.schema.json",
  "title": "AssessmentReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "requestDigest", "metadataDigest", "assessments", "approvalSummary", "approvalDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "format": "uuid" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "metadataDigest": { "$ref": "#/$defs/digest" },
    "approvalDigest": { "$ref": "#/$defs/digest" },
    "approvalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestDigest", "metadataDigest", "requirements", "plannedFiles", "handoffs", "blockers"],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "metadataDigest": { "$ref": "#/$defs/digest" },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirementId", "classification", "status"],
            "properties": {
              "requirementId": { "type": "string", "minLength": 1 },
              "classification": { "$ref": "#/$defs/classification" },
              "status": { "$ref": "#/$defs/status" }
            }
          }
        },
        "plannedFiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "handoffs": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "classification", "status", "reasons", "evidence"],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "classification": { "$ref": "#/$defs/classification" },
          "status": { "$ref": "#/$defs/status" },
          "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "handoffId": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "classification": { "enum": ["STANDARD", "LOCAL_ANNOTATION", "EXTENSION", "CUSTOM_PAGE", "FREESTYLE_SAPUI5", "BACKEND_CHANGE_REQUIRED"] },
    "status": { "enum": ["READY", "BLOCKED_BY_AUTH", "BLOCKED_BY_BACKEND", "ROUTED_TO_EXTENSION", "ROUTED_TO_CUSTOM_PAGE", "REQUIRES_ARCHITECTURE_DECISION", "VERIFIED", "FAILED", "DEFERRED"] }
  }
}
