{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "RunState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "state", "requestDigest", "createdAt", "updatedAt", "artifacts", "errors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "format": "uuid" },
    "state": { "enum": ["NEW", "ASSESSED", "AWAITING_APPROVAL", "APPROVED", "GENERATING", "VERIFYING", "FINALIZED", "FAILED", "BLOCKED"] },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvalDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "resumeFrom": { "enum": ["ASSESSED", "AWAITING_APPROVAL", "APPROVED", "GENERATING", "VERIFYING"] },
    "artifacts": { "type": "object", "additionalProperties": { "type": "string" } },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
