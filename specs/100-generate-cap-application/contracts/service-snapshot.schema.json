{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/btp-agent/cap-service-snapshot.schema.json",
  "title": "Protocol 100 Service Snapshot",
  "type": "object",
  "required": ["snapshotVersion", "odataVersion", "serviceName", "serviceUrlHint", "entitySets", "operations", "metadataPath", "modelDigest"],
  "properties": {
    "snapshotVersion": { "const": "1.0" },
    "odataVersion": { "const": "4.0" },
    "serviceName": { "type": "string", "minLength": 1 },
    "serviceUrlHint": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]+/$" },
    "entitySets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "keys", "properties", "navigation", "capabilities"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type", "nullable"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "nullable": { "type": "boolean" },
                "maxLength": { "type": ["integer", "null"], "minimum": 1 },
                "precision": { "type": ["integer", "null"], "minimum": 1 },
                "scale": { "type": ["integer", "null"], "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "navigation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "target", "cardinality"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 },
                "cardinality": { "enum": ["TO_ONE", "TO_MANY"] }
              },
              "additionalProperties": false
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["READ", "CREATE", "UPDATE", "DELETE"] }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "boundTo", "parameters", "returns"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["ACTION", "FUNCTION"] },
          "boundTo": { "type": ["string", "null"] },
          "parameters": { "type": "array", "items": { "type": "object" } },
          "returns": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "metadataPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*(?:^|/)[.][.](?:/|$)).+$" },
    "modelDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
