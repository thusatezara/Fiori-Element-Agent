{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fiori-agent/standard-generation-request.schema.json",
  "title": "Standard Generation Request",
  "type": "object",
  "required": ["handoffVersion", "selectedType", "approvedAt", "serviceSnapshotPath", "outputIntent", "rootEntitySet", "usageProfile", "editIntent"],
  "properties": {
    "handoffVersion": { "const": "1.0" },
    "selectedType": { "const": "STANDARD" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "serviceSnapshotPath": { "type": "string", "minLength": 1 },
    "outputIntent": {
      "type": "object",
      "required": ["parentDirectory", "projectName"],
      "properties": {
        "parentDirectory": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      },
      "additionalProperties": false
    },
    "rootEntitySet": { "type": "string", "minLength": 1 },
    "usageProfile": {
      "type": "object",
      "required": ["primaryDevice", "expectedResultSize", "columnDensity"],
      "properties": {
        "primaryDevice": { "enum": ["DESKTOP", "MOBILE", "MIXED"] },
        "expectedResultSize": { "type": "integer", "minimum": 0 },
        "columnDensity": { "enum": ["LOW", "MEDIUM", "HIGH"] }
      },
      "additionalProperties": false
    },
    "editIntent": { "enum": ["READ_ONLY", "OBJECT_PAGE", "INLINE"] },
    "exportIntent": { "enum": ["NONE", "EXCEL"] },
    "flpIntent": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "extensionRequest": {
      "type": ["object", "null"],
      "properties": {
        "type": { "enum": ["CUSTOM_ACTION", "CUSTOM_COLUMN", "CUSTOM_SECTION"] },
        "requirementId": { "type": "string" },
        "standardAlternative": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["type", "requirementId", "standardAlternative", "reason"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
