{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fiori-agent/service-snapshot.schema.json",
  "title": "Normalized OData V4 Service Snapshot",
  "type": "object",
  "required": ["snapshotVersion", "sourceKind", "sourceDisplay", "serviceRoot", "metadataSha256", "odataVersion", "schemas", "entitySets", "entityTypes", "operations", "capabilities", "warnings"],
  "properties": {
    "snapshotVersion": { "const": "1.0" },
    "sourceKind": { "enum": ["FILE", "URL"] },
    "sourceDisplay": { "type": "string", "minLength": 1 },
    "serviceRoot": { "type": ["string", "null"], "format": "uri" },
    "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "odataVersion": { "const": "4.0" },
    "schemas": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "entitySets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "entityType"],
        "properties": {
          "name": { "type": "string" },
          "entityType": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "entityTypes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "operations": { "type": "array", "items": { "type": "object" } },
    "annotations": { "type": "array", "items": { "type": "object" } },
    "capabilities": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "sourceKind": { "const": "URL" } } },
      "then": { "properties": { "serviceRoot": { "type": "string", "pattern": "^https://" } } }
    },
    {
      "if": { "properties": { "sourceKind": { "const": "FILE" } } },
      "then": { "properties": { "serviceRoot": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
