{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fiori-agent/handoff.schema.json",
  "title": "Approved Fiori Generation Handoff",
  "type": "object",
  "required": ["handoffVersion", "assessmentId", "selectedType", "request", "serviceSnapshotPath", "generationInput", "prerequisites", "outputIntent", "requestedAt"],
  "properties": {
    "handoffVersion": { "const": "1.0" },
    "assessmentId": { "type": "string", "format": "uuid" },
    "selectedType": { "enum": ["STANDARD", "CUSTOM", "FREESTYLE"] },
    "request": {
      "type": "object",
      "required": ["requestId", "originalText", "requirements", "answers"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "originalText": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "answers": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "serviceSnapshotPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+$" },
    "generationInput": { "type": "object" },
    "prerequisites": { "type": "array", "items": { "type": "object" } },
    "outputIntent": {
      "type": "object",
      "required": ["parentDirectory", "projectName"],
      "properties": {
        "parentDirectory": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
